{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime.version": "Lua 5.1",
  "runtime.builtin": {
    "basic": true,
    "coroutine": true,
    "math": true,
    "string": true,
    "table": true
  },
  "workspace.checkThirdParty": false,
  "workspace.library": [
    "../_LuaStubs"
  ],
  "workspace.ignoreDir": [
    "Libs",
    "Libs/**",
    "**/Libs",
    "**/Libs/**",
    "z Backup",
    "z Library",
    "zz Archive (DONT TOUCH)"
  ],
  "type.weakUnionCheck": true,
  "diagnostics.neededFileStatus": "Any",
  "diagnostics.disable": [
    "invisible",
    "undefined-global",
    "undefined-field"
  ]
}
